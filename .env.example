# App api_id из https://my.telegram.org/apps (API development tools).
TELEGRAM_API_ID=
# App api_hash того же приложения из https://my.telegram.org/apps.
TELEGRAM_API_HASH=
# Токен Telegram-бота из https://t.me/BotFather.
TELEGRAM_BOT_TOKEN=

# Путь к другому TOML. По умолчанию бот читает games.toml из папки проекта.
# GAMES_CONFIG=games.toml

# Эти поля нужны источнику minecraft_realms для доступа к базе токенов.
# Имя пользователя MySQL.
MYSQL_USER=
# Пароль пользователя MySQL.
MYSQL_PASSWORD=
# Домен или IP сервера MySQL.
MYSQL_HOST=
# TCP-порт сервера MySQL.
MYSQL_PORT=3306
# Имя базы MySQL, в которой RealmStatus хранит токены.
MYSQL_DB=

# Базовый URL API Stardew Valley. Используется, если base_url в TOML не указан.
STARDEW_API_BASE_URL=
# Токен авторизации для API Stardew Valley.
STARDEW_API_TOKEN=
